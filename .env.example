# Vehicle region (US, CA, or EU) — not sensitive, safe to keep server-side
BLUELINK_REGION=US

# Secret token for the webhook — generate with: openssl rand -hex 32
WEBHOOK_TOKEN=replace_with_a_long_random_secret

# AES-256-GCM key used to decrypt the credentials payload from the shortcut
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or run: npm run generate-shortcut (without --encryption-key) to have one created for you
ENCRYPTION_KEY=replace_with_64_char_hex_string
