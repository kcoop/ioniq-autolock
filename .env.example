# Hyundai Bluelink credentials
BLUELINK_USERNAME=your@email.com
BLUELINK_PASSWORD=your_bluelink_password
BLUELINK_PIN=your_4digit_pin
BLUELINK_REGION=US   # US, CA, EU
BLUELINK_VIN=your_vehicle_vin

# Secret token for the webhook — generate with: openssl rand -hex 32
WEBHOOK_TOKEN=replace_with_a_long_random_secret
